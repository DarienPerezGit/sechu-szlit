# Supabase project (SECHUB). Copy this file to .env.local and fill in the values.
# These are Vite-exposed (VITE_ prefix) and safe for the frontend bundle:
# the publishable/anon key is designed to be public and only makes sense
# together with the project URL. No service_role/admin key belongs here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
